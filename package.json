{
  "name": "next-circular-dependency",
  "description": "Detect circular dependencies in your Next.js app",
  "version": "1.0.1",
  "license": "MIT",
  "main": "index.js",
  "repository": "tiaanduplessis/next-circular-dependency",
  "scripts": {
    "lint": "eslint index.js test.js eslint.config.mjs --max-warnings=0",
    "test": "node test.js",
    "check": "npm run lint && npm test",
    "format": "npm run lint -- --fix"
  },
  "keywords": [
    "next",
    "nextjs",
    "circular-dependency",
    "circular-dependency-plugin"
  ],
  "dependencies": {
    "circular-dependency-plugin": "^5.2.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "eslint": "10.12.0"
  }
}
